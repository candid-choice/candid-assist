{
  "name": "candid-assist-monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:backend\" \"pnpm dev:renderer\" \"pnpm dev:electron\" \"pnpm dev:firebase\"",
    "dev:web": "pnpm --filter web dev",
    "dev:backend": "pnpm --filter backend start:dev",
    "dev:renderer": "pnpm --filter desktop-renderer dev",
    "dev:electron": "pnpm --filter harness-desktop-electron dev",
    "dev:firebase": "firebase emulators:start",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter web build",
    "build:backend": "pnpm --filter backend build",
    "type-check": "pnpm --filter desktop-renderer exec tsc --noEmit",
    "lint": "pnpm -r lint",
    "test": "echo 'No tests configured yet'",
    "postinstall": "pnpm -r --filter '!backend' --filter '!harness-desktop' build 2>/dev/null || true"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": "7.2.4"
    }
  }
}

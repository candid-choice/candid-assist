# ==============================================================================
# Port Configuration
# All local service ports — change here or via environment.
# -----------------------------------------------------------------
# Web        — 3600  Next.js development server
# Backend    — 3601  NestJS API server
# -----------------------------------------------------------------
# Firebase   — 3602  Authentication emulator
# Firebase   — 3613  Firestore emulator
# Firebase   — 3604  Storage emulator
# Firebase   — 3605  Functions emulator (reserved)
# Firebase   — 3606  Hosting emulator (reserved)
# Firebase   — 3607  Emulator UI
# Firebase   — 3608  Realtime Database emulator
# Firebase   — 3609  Pub/Sub emulator
# ==============================================================================

WEB_PORT=3600
BACKEND_PORT=3601

FIREBASE_AUTH_PORT=3602
FIREBASE_FIRESTORE_PORT=3613
FIREBASE_STORAGE_PORT=3604
FIREBASE_FUNCTIONS_PORT=3605
FIREBASE_HOSTING_PORT=3606
FIREBASE_UI_PORT=3607
FIREBASE_DATABASE_PORT=3608
FIREBASE_PUBSUB_PORT=3609

# Firebase project ID (used locally — never prod)
FIREBASE_PROJECT_ID=candid-assist

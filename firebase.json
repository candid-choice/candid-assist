{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "region": "us-central1",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"],
      "predeploy": ["pnpm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "emulators": {
    "auth": {
      "port": 3602
    },
    "firestore": {
      "port": 3613
    },
    "storage": {
      "port": 3604
    },
    "functions": {
      "port": 3620
    },
    "ui": {
      "enabled": true,
      "port": 3607
    }
  },
  "auth": {
    "providers": {
      "emailPasswordSignIn": {},
      "googleSignIn": {
        "oAuthBrandDisplayName": "Human Assist",
        "supportEmail": "support@candidchoice.ai"
      }
    }
  }
}

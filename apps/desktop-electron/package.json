{
  "name": "harness-desktop-electron",
  "version": "0.1.0",
  "description": "Human Assist desktop — Electron runtime (migration track). Reuses the renderer from apps/desktop.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --mac",
    "test": "echo 'renderer tests live in apps/desktop (runtime-agnostic)' && exit 0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "uuid": "^11.1.0",
    "ws": "^8.18.2"
  },
  "build": {
    "appId": "com.candidchoice.humanassist",
    "productName": "Human Assist",
    "files": [
      "out/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ]
    }
  }
}

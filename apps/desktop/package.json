{
  "name": "harness-desktop",
  "version": "0.1.0",
  "description": "Human Assist desktop — Electron runtime. UI is served by apps/desktop-renderer (Next.js).",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "pnpm --filter desktop-renderer build && electron-vite build && electron-builder --mac",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/ws": "^8",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "electron-updater": "^6.8.11",
    "uuid": "^11.1.0",
    "ws": "^8.18.2"
  },
  "build": {
    "appId": "com.candidchoice.humanassist",
    "productName": "Human Assist",
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "../desktop-renderer/out",
        "to": "renderer"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ]
    }
  }
}
